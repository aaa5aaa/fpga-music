// ---- BLE 模块 UART (ESP32-C3) --------------------------------------------
//   模块 TXD -> D14, 模块 RXD -> D15, 模块 STATE -> C14 (可选)
//   模块供电必须 3.3V (ESP32-C3 可从扩展口 5V 取电再自己稳压)
IO_LOC "bt_rx" D14;
IO_PORT "bt_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "bt_tx" D15;
IO_PORT "bt_tx" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "bt_state" C14;
IO_PORT "bt_state" IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;

// ---- 板载 USB-UART (J21/M15), PC 调试/兜底 --------------------------------
IO_LOC "dbg_rx" J21;
IO_PORT "dbg_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "dbg_tx" M15;
IO_PORT "dbg_tx" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

