// ---- 8 行 x 4 列 矩阵键盘 (32 键) ----------------------------------------
// 按原工程 cst 的接法: 行 = A13/A14/A15/A16/A18/A19/F13/F14
//                     列 = B13/C13/E14/E13
// FPGA 驱动 4 根列线(低有效), 读取 8 根行线(开内部上拉)
// 如果实际接线不同, 只改下面这 12 行即可
IO_LOC "columns[3]" B13;
