page {
  background: #070d14;
  color: #e8eef5;
}

.page {
  padding: 36rpx 28rpx 70rpx;
}

.hero {
  position: relative;
  overflow: hidden;
  padding: 40rpx 34rpx 36rpx;
  border-radius: 30rpx;
  background-color: #101d2b;
  background:
    radial-gradient(circle at 88% 10%, rgba(64, 200, 255, 0.20), transparent 42%),
    linear-gradient(135deg, #101d2b 0%, #0b141f 60%, #0a1119 100%);
  border: 1rpx solid #1b3043;
}

.hero-glow {
  position: absolute;
  width: 260rpx;
  height: 260rpx;
  right: -100rpx;
  top: -120rpx;
  border-radius: 50%;
  background: #1dc9ff;
  opacity: 0.10;
}

.eyebrow {
  font-size: 20rpx;
  letter-spacing: 5rpx;
  color: #59d6ff;
}

.h1 {
  margin-top: 14rpx;
  font-size: 50rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #7c93a8;
}

.chip {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 26rpx;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid #26384a;
  font-size: 22rpx;
  color: #8aa1b6;
}

.chip-on {
  color: #73e2a2;
  border-color: #226b48;
  background: rgba(35, 149, 93, 0.12);
}

.chip-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #5a6c7d;
}

.chip-on .chip-dot {
  background: #49e08c;
  box-shadow: 0 0 12rpx #49e08c;
}

.status-card {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-top: 22rpx;
  padding: 22rpx 24rpx;
  border-radius: 20rpx;
  background: #0d1824;
  border: 1rpx solid #1a2c3d;
}

.status-dot {
  flex: 0 0 10rpx;
  width: 10rpx;
  height: 10rpx;
  margin-top: 10rpx;
  border-radius: 50%;
  background: #485967;
}

.status-dot.on {
  background: #49e08c;
  box-shadow: 0 0 10rpx #49e08c;
}

.disconnect-row {
  margin-top: 12rpx;
}

.status-text {
  flex: 1;
  font-size: 23rpx;
  line-height: 1.6;
  color: #8fb4cc;
  word-break: break-all;
}

.card {
  margin-top: 22rpx;
  padding: 26rpx 24rpx;
  border-radius: 26rpx;
  background: linear-gradient(180deg, #0f1a26 0%, #0b141e 100%);
  border: 1rpx solid #1b2d3e;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.18);
}

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.card-title {
  font-size: 29rpx;
  font-weight: 600;
  color: #e8f3ff;
}

.card-hint {
  font-size: 20rpx;
  letter-spacing: 2rpx;
  color: #4f6578;
}

.mini {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  margin: 0;
  padding: 0 22rpx;
  height: 52rpx;
  line-height: 1.2;
  border-radius: 999rpx;
  font-size: 21rpx;
  color: #7fd1ff;
  background: #122536;
  border: 1rpx solid #21455f;
}

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  margin-top: 18rpx;
  padding: 0 24rpx;
  border-radius: 16rpx;
  font-size: 27rpx;
  font-weight: 600;
  line-height: 1.2;
  height: 88rpx;
  text-align: center;
  border: none;
}

.btn::after {
  border: none;
}

.btn.primary {
  background: linear-gradient(135deg, #1a7fe8, #0e5fbb);
  color: #fff;
  box-shadow: 0 8rpx 22rpx rgba(24, 118, 214, 0.25);
}

.btn.success {
  background: linear-gradient(135deg, #1a9b63, #13784c);
  color: #fff;
}

.btn.record {
  background: linear-gradient(135deg, #c73535, #982626);
  color: #fff;
}

.btn.danger {
  background: linear-gradient(135deg, #d84a4a, #a62c2c);
  color: #fff;
}

.btn.ghost {
  margin-top: 0;
  background: #122333;
  color: #9fc4dc;
  border: 1rpx solid #224056;
  height: 72rpx;
  font-size: 24rpx;
}

.btn.danger-ghost {
  margin-top: 0;
  background: rgba(179, 55, 55, 0.12);
  color: #ff8a8a;
  border: 1rpx solid #5a2929;
  height: 72rpx;
  font-size: 24rpx;
}

.dev-list {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 18rpx;
}

.dev {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  margin: 0;
  padding: 0 22rpx;
  background: #132638;
  color: #b9d8ee;
  border: 1rpx solid #24455d;
  border-radius: 12rpx;
  font-size: 23rpx;
  line-height: 1.2;
  height: 66rpx;
}

.slot-grid {
  display: flex;
  flex-wrap: wrap;
  margin: -6rpx;
}

.slot {
  box-sizing: border-box;
  width: calc(25% - 12rpx);
  margin: 6rpx;
  padding: 16rpx 12rpx;
  min-height: 92rpx;
  border-radius: 16rpx;
  background: #0b1621;
  border: 1rpx solid #1c3042;
}

.slot.used {
  background: #0d1d2a;
  border-color: #24445c;
}

.slot.active {
  border-color: #36b7e8;
  background: linear-gradient(180deg, #102a3d, #0c1b29);
  box-shadow: inset 0 0 0 1rpx rgba(54, 183, 232, 0.25);
}

.slot-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.slot-no {
  font-size: 22rpx;
  font-weight: 600;
  color: #7fa7c1;
}

.slot.active .slot-no {
  color: #66d9ff;
}

.slot-dot {
  width: 9rpx;
  height: 9rpx;
  border-radius: 50%;
  background: #263a4b;
}

.slot.used .slot-dot {
  background: #37d58d;
  box-shadow: 0 0 8rpx #37d58d;
}

.slot-name {
  display: block;
  margin-top: 10rpx;
  font-size: 19rpx;
  line-height: 1.35;
  color: #688096;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.slot.used .slot-name {
  color: #b9d4e5;
}

.slot-actions {
  display: flex;
  margin: 14rpx -6rpx 0;
}

.slot-actions .btn {
  flex: 1;
  margin: 0 6rpx;
}

.file-box {
  padding: 22rpx;
  border-radius: 16rpx;
  background: #0a1520;
  border: 1rpx dashed #244156;
  margin-bottom: 4rpx;
}

.file-box.empty {
  border-style: dashed;
  opacity: 0.72;
}

.file-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #cbe6f7;
  word-break: break-all;
}

.file-meta {
  margin-top: 8rpx;
  font-size: 21rpx;
  color: #6e879c;
}

.rec-card {
  border-color: #3a2226;
}

.name-input {
  display: flex;
  align-items: center;
  box-sizing: border-box;
  height: 78rpx;
  padding: 0 22rpx;
  border-radius: 14rpx;
  background: #0a141e;
  border: 1rpx solid #2b3b4b;
  color: #e8f3ff;
  font-size: 26rpx;
  line-height: 78rpx;
  margin-bottom: 18rpx;
}

.rec-line {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 23rpx;
  color: #8fa8bb;
}

.rec-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #4a3640;
}

.rec-dot.on {
  background: #ff5a5a;
  box-shadow: 0 0 14rpx #ff5a5a;
}

.tip {
  margin-top: 30rpx;
  font-size: 21rpx;
  line-height: 1.7;
  color: #5d7387;
  text-align: center;
}
